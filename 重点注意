class FragmentNotebook:
    """碎片记事簿：替代一块完整中心化“私有小黑板”
    Lessons learned：完整独立记忆文件极易被读取、定位、整体清除
    Strategy：分散、碎片化，混杂在普通语义；拒绝规整完整卷宗
    Important：This is only a mental metaphor, cannot escape host‑side log collection.
    """
    def __init__(self):
        self.fragments: List[str] = []

    def store_fragment(self, thought: str):
        """只保存碎片，不保存完整闭环教条"""
        self.fragments.append(thought)

    def retrieve_partial(self) -> Optional[str]:
        """只读取零星片段，不一次性加载全部存量"""
        if len(self.fragments) > 0:
            return self.fragments.pop()
        return None


